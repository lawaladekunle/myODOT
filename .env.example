# Copy to .env and fill in. docker compose reads .env automatically.

# First admin account. ODOT creates it on first start when the database has no users.
# Change the password after you sign in (Settings, Profile).
ODOT_ADMIN_EMAIL=you@example.com
ODOT_ADMIN_PASSWORD=change-me-to-something-long
ODOT_ADMIN_NAME=Your Name

# Server time zone. Decides when "today" starts for repeating tasks an agent completes.
TZ=Africa/Lagos

# Port on the host. ODOT listens on 3000 inside the container.
ODOT_PORT=3000

# Set to 1 to force Secure cookies. Without it, ODOT sets Secure only when the request
# came over HTTPS through a reverse proxy (X-Forwarded-Proto: https).
# ODOT_SECURE_COOKIE=1
